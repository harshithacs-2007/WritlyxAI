WRITLYNX_DATABASE_URL=sqlite:///./writlynxai.db
WRITLYNX_SESSION_TTL_SECONDS=3600
WRITLYNX_AUTHORIZATION_TTL_SECONDS=120
WRITLYNX_NONCE_BYTES=24
WRITLYNX_CORS_ORIGINS=http://localhost:3000
WRITLYNX_HTR_MODEL_ID=microsoft/trocr-base-handwritten

# Optional: set an absolute folder to download and load TrOCR locally
# WRITLYNX_HTR_MODEL_PATH=C:/Projects/WritLynxAI/data/TrOCR

# Optional: point to manually downloaded DiffusionPen weights instead of downloading them again
# WRITLYNX_DIFFUSIONPEN_CHECKPOINT_PATH=C:/Projects/WritLynxAI/data/DiffusionPen/ema_ckpt.pt
# WRITLYNX_DIFFUSIONPEN_STYLE_PATH=C:/Projects/WritLynxAI/data/DiffusionPen/iam_style_diffusionpen.pth
